    "retrieval": {
      "label": "Engineering settings for an offline pipeline check. They are not the approved scientific protocol.",
      "scope": "one index per document, built from every declared page; a question searches only its own document",
      "embedding_backend": "local-hash-v1",
      "embedding_dimensions": 256,
      "embedding": "signed feature hashing of blake2b token digests, L2-normalised, no model download",
      "reranker": null,
      "chunking": {
        "function": "faar.chunking.build_page_chunks",
        "policy": "cjk-weighted-words-v1",
        "chunk_size_words": 180,
        "chunk_overlap_words": 40,
        "chunk_id": "<doc_id>-p<page_idx>-c<chunk_index>",
        "pages_without_text": "empty or missing OCR gives no chunk and is counted in ocr_condition",
        "units": "a CJK character (Han, Hiragana, Katakana) is one unit of weight 1; any other run of non-space characters is one unit of weight 2",
        "cjk_chars_per_word": 2,
        "window": "chunk_size_words * 2 weight, so a chunk holds at most 360 CJK characters or 180 other words; the window advances by (chunk_size_words - chunk_overlap_words) words on the same scale",
        "chunk_text": "the page text of the span, each run of whitespace replaced by one space",
        "without_cjk": "text with no CJK character gets the boundaries and the chunk text of whitespace-words-v1"
      },
      "tokenisation": {
        "tokenizer": "multilingual-v1",
        "definition": "NFKC, casefold, delete whitespace between CJK characters, then runs of Unicode letters or digits plus % and $ as word tokens and overlapping character bigrams for each CJK run",
        "applied_to": "chunk text and query text alike, for BM25 and for the hashing embedder",
        "retrieval_tokeniser": "multilingual-v1",
        "normalisation": "Unicode NFKC, then casefold (the Unicode data version is in environment.unicodedata)",
