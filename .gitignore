logs/
artifacts/
OHR-Bench/

data/ohr_bench_raw/
data/benchmark_prep/
data/benchmark_assets_smoke/
data/external/
results/smoke/
paper/build/
OHR-Bench/.git/
*.partial

tmp/
cache/
results/calibration/
results/baselines/
results/environment/preflight*.json
cluster/preflight_*.json

# Rendered pilot pages are derived from the OHR PDFs; regenerate with scripts/data/build_pilot.py.
results/pilots/*/inspection/pages/
